<Window x:Class="FlareQuotes.App.Views.TextMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Text message" Width="920" Height="720" MinWidth="800" MinHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MessageTemplateList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FlareTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FlareFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MessageTemplateItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FlareTextBrush}" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FlareFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FlareAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="TextMessageFrame" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
            Background="{DynamicResource WindowGlassTintBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource WindowGlassTitleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Text message" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close text message"
                            AutomationProperties.Name="Close text message" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource CloseIconGeometry}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource FlareMutedTextBrush}" StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,22,22,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="TEMPLATES" Style="{StaticResource EyebrowText}" Margin="6,0,0,14" />
                        <ListBox x:Name="TemplateList" Grid.Row="1" Style="{StaticResource MessageTemplateList}"
                                 ItemContainerStyle="{StaticResource MessageTemplateItem}" SelectionChanged="TemplateList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Text message templates" ToolTip="Choose a reusable message">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Body}" Foreground="{DynamicResource FlareMutedTextBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,14,0,0">
                            <Button x:Name="AddTemplateButton" Content="New" Click="AddTemplate_Click" Margin="0,0,4,0"
                                    ToolTip="Create a template" AutomationProperties.Name="Add text message template" Padding="6,6" />
                            <Button x:Name="EditTemplateButton" Content="Edit" Click="EditTemplate_Click" Margin="2,0,2,0"
                                    ToolTip="Edit the selected template" AutomationProperties.Name="Edit text message template" Padding="6,6" />
                            <Button x:Name="DeleteTemplateButton" Content="Delete" Click="DeleteTemplate_Click" Margin="4,0,0,0"
                                    ToolTip="Delete the selected template" AutomationProperties.Name="Delete text message template" Padding="6,6" />
                        </UniformGrid>
                        <Button x:Name="UndoDeleteButton" Grid.Row="3" Content="Undo delete" Click="UndoDelete_Click"
                                Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,5,0,0"
                                ToolTip="Restore the last deleted template" AutomationProperties.Name="Undo template deletion" />
                        <StackPanel Grid.Row="4" Margin="2,22,2,0">
                            <TextBlock Text="Your name" Foreground="{DynamicResource FlareMutedTextBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBox x:Name="SalesNameBox" MaxLength="80" TextChanged="SalesNameBox_TextChanged" LostFocus="SalesNameBox_LostFocus"
                                     AutomationProperties.Name="Your name for message templates" ToolTip="Used by the SalesName token" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel x:Name="RecipientPanel">
                        <TextBlock x:Name="QuoteContextText" Foreground="{DynamicResource FlareMutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                        <TextBlock Text="Recipient number" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="PhoneBox" TextChanged="PhoneBox_TextChanged" MaxLength="40"
                                     AutomationProperties.Name="Text message recipient number" ToolTip="Use the quote phone number or type another number">
                                <TextBox.ContextMenu><ContextMenu><MenuItem Header="Use quote phone number" Click="UseQuoteNumber_Click" /></ContextMenu></TextBox.ContextMenu>
                            </TextBox>
                            <Button x:Name="CopyNumberButton" Grid.Column="2" Content="Copy number" Click="CopyNumber_Click"
                                    ToolTip="Copy this number for Phone Link" AutomationProperties.Name="Copy text message recipient number" />
                        </Grid>
                        <TextBlock x:Name="PhoneStatusText" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>

                    <Grid x:Name="ComposerPanel" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Message" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Reset to template" Click="ResetPreview_Click" Style="{StaticResource QuietButton}"
                                    Padding="8,4" MinHeight="28" ToolTip="Restore the selected template with this quote's details"
                                    AutomationProperties.Name="Reset message to selected template" />
                        </Grid>
                        <TextBox x:Name="MessageBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" MinHeight="150" MaxLength="10000" Padding="14,12"
                                 TextChanged="MessageBox_TextChanged" FontSize="14" AutomationProperties.Name="Editable personalized text message"
                                 ToolTip="Edit this message without changing the saved template" />
                        <Grid Grid.Row="2" Margin="0,7,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewFeedbackText" FontSize="11" Foreground="{DynamicResource FlareMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <TextBlock x:Name="CharacterCountText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource FlareMutedTextBrush}" />
                        </Grid>
                        <StackPanel Grid.Row="3">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                <Button x:Name="CopyMessageButton" Content="Copy message" Click="CopyMessage_Click" Style="{StaticResource PrimaryButton}"
                                        Height="40" ToolTip="Copy this message to paste and review in Phone Link" AutomationProperties.Name="Copy personalized text message" />
                                <Button x:Name="OpenPhoneLinkButton" Grid.Column="2" Content="Copy &amp; open Phone Link" Click="OpenPhoneLink_Click" Height="40"
                                        ToolTip="Copy this message and open Phone Link; paste and review before sending" AutomationProperties.Name="Open Windows Phone Link" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="EditorPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="92" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="EditorHeadingText" Text="Edit template" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Template name" Foreground="{DynamicResource FlareMutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
                            <TextBox x:Name="TemplateNameBox" MaxLength="80"
                                     AutomationProperties.Name="Text message template name" ToolTip="Template name" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Template message" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <TextBox x:Name="TemplateBodyBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" MinHeight="80" MaxLength="4000" TextChanged="TemplateBodyBox_TextChanged"
                                 AutomationProperties.Name="Reusable template message" ToolTip="Save reusable wording with tokens for quote details" />
                        <WrapPanel Grid.Row="4" Margin="0,8,0,4">
                            <Button Content="{}{FirstName}" Tag="FirstName" Style="{StaticResource TokenButton}" Click="InsertToken_Click" ToolTip="Insert customer first name" />
                            <Button Content="{}{Project}" Tag="Project" Style="{StaticResource TokenButton}" Click="InsertToken_Click" ToolTip="Insert project name" />
                            <Button Content="{}{Model}" Tag="Model" Style="{StaticResource TokenButton}" Click="InsertToken_Click" ToolTip="Insert fireplace model" />
                            <Button Content="{}{Consultation}" Tag="Consultation" Style="{StaticResource TokenButton}" Click="InsertToken_Click" ToolTip="Insert consultation link" />
                            <Button Content="{}{SalesName}" Tag="SalesName" Style="{StaticResource TokenButton}" Click="InsertToken_Click" ToolTip="Insert your name" />
                        </WrapPanel>
                        <TextBlock Grid.Row="5" Text="Personalized preview" Foreground="{DynamicResource FlareMutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
                        <Border Grid.Row="6" Padding="10,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="EditorPreviewText" TextWrapping="Wrap" FontSize="12" /></ScrollViewer>
                        </Border>
                        <TextBlock x:Name="EditorStatusText" Grid.Row="7" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10" />
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <Button Content="Save template" Click="SaveTemplate_Click" Style="{StaticResource PrimaryButton}" Height="38"
                                    ToolTip="Save this reusable template" AutomationProperties.Name="Save text message template" />
                            <Button Grid.Column="2" Content="Cancel" Click="CancelEdit_Click" Height="38" ToolTip="Discard template changes"
                                    AutomationProperties.Name="Cancel text message template editing" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,0">
                <TextBlock x:Name="MessageStatusText" VerticalAlignment="Center" Foreground="{DynamicResource FlareMutedTextBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Border>
</Window>
